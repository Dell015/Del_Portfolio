# ─── Contact form email delivery ───────────────────────────────────────────────
# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit keys.
#
# Without RESEND_API_KEY the site still builds and runs: the footer contact form
# renders a `mailto:` fallback instead of a live form, and POST /api/contact
# returns 503. Nothing breaks.

# Required to enable the form. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Where messages are delivered. Defaults to `contact.email` in
# src/lib/content/site.ts when unset.
CONTACT_TO_EMAIL=

# Sender address. Defaults to Resend's shared testing sender
# (onboarding@resend.dev), which only delivers to the address that owns the API
# key. Set this to an address on a domain you've verified in Resend to send from
# your own domain.
CONTACT_FROM_EMAIL=

# ─── Optional: Cloudflare Turnstile ───────────────────────────────────────────
# Not currently wired up. See the TURNSTILE HOOK comment in
# src/app/api/contact/route.ts for what to implement if spam becomes a problem.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
